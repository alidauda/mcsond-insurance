# ── Database ──────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, or local Postgres). This app
# owns its own database — never point it at the cement portal's DB.
DATABASE_URL="postgresql://user:password@localhost:5432/mcsond_insurance"

# ── Better Auth ───────────────────────────────────────────────
# Generate a secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-string"
# Base URL of the app (no trailing slash). Used for OAuth callbacks. Dev runs on
# port 3001 so it can sit next to the cement portal on 3000.
BETTER_AUTH_URL="http://localhost:3001"
# Optional extra trusted origins for production (comma-separated).
# BETTER_AUTH_TRUSTED_ORIGINS="https://insurance.mcsond.ng"

# ── Google OAuth ──────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Staff gating ──────────────────────────────────────────────
# Email domain whose accounts are treated as internal staff.
STAFF_DOMAIN="mcsond.ng"
# Comma-separated emails that always become superadmin.
SUPERADMIN_EMAILS="bisi@mcsond.ng"

# ── Email (Resend) ────────────────────────────────────────────
# API key from https://resend.com/api-keys
RESEND_API_KEY=""
# Verified-domain sender (https://resend.com/domains). The default is Resend's
# test address, which only delivers to your own Resend account — set a real
# verified sender for production staff invites.
EMAIL_FROM="McSond Insurance <onboarding@resend.dev>"

# ── Paystack ──────────────────────────────────────────────────
# Keys from https://dashboard.paystack.com/#/settings/developers.
# These are FALLBACKS: keys set in Admin → Settings (stored in the DB) override
# them, so ops can rotate keys without a redeploy. Leave these set for local dev
# / first boot before any admin has saved keys.
# Wallet top-ups: initialize + verify run server-side with the secret key;
# amounts are sent in kobo. Test card: 4084 0840 8408 4081 · exp any future · CVV 408.
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Public key (not secret). Only needed if you add a client-side/inline flow.
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Webhook: point the dashboard's Test Webhook URL at
#   https://<your-ngrok-host>/api/paystack/webhook
# (run `ngrok http 3001` and copy the https host). The browser callback URL is
# derived from BETTER_AUTH_URL and needs no ngrok.


# ── NEM Insurance (eInsurance broker API) ─────────────────────
# Retail broker credentials from NEM. These are FALLBACKS: values saved in
# Admin → Settings (stored in the DB) override them. The sandbox host is
# https://sandbox.einsurance.nem-insurance.com — swap for production when live.
NEM_BASE_URL="https://sandbox.einsurance.nem-insurance.com"
NEM_USERNAME=""
NEM_PASSWORD=""
NEM_API_KEY=""

# ── SwiftCheck / SwiftLink (NIN identity verification) ────────
# Credentials from SwiftLink. FALLBACKS: values saved in Admin → Settings
# (stored in the DB) override them. Dev host is swiftcheck-dev; swap to
# swiftcheck-prod when live. Note that raw-NIN lookups need to be enabled on
# your business account — the gateway returns 403 until they are.
SWIFTCHECK_BASE_URL="https://swiftcheck-dev.swiftlink.ng"
SWIFTCHECK_CLIENT_ID=""
SWIFTCHECK_CLIENT_SECRET=""
